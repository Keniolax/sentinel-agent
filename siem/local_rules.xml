<!-- Week 18: rules that show the capstone's logs reached the SIEM. Week 19 adds detections. -->
<group name="sentinel,azure,">
  <rule id="100810" level="3">
    <decoded_as>json</decoded_as>
    <field name="sentinel_source">^storage$</field>
    <field name="OperationName">^GetBlob$|^ListBlobs$</field>
    <description>Sentinel: blob read on a capstone storage account ($(OperationName) $(ObjectKey))</description>
  </rule>
  <rule id="100811" level="3">
    <decoded_as>json</decoded_as>
    <field name="sentinel_source">^job$</field>
    <field name="sentinel.app">^sentinel-agent$</field>
    <description>Sentinel: agent event $(sentinel.event) in run $(sentinel.run_id)</description>
  </rule>
</group>
